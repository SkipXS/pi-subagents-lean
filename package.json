{
  "name": "pi-subagents-lean",
  "version": "0.4.0",
  "description": "Lightweight sub-agents for pi — spawn specialized agents with isolated sessions, tools, and models.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "subagents",
    "ai",
    "agents"
  ],
  "author": "SkipXS",
  "contributors": [
    "Alexander Paramonov"
  ],
  "license": "MIT",
  "packageManager": "bun@1",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkipXS/pi-subagents-lean.git"
  },
  "homepage": "https://github.com/SkipXS/pi-subagents-lean#readme",
  "bugs": {
    "url": "https://github.com/SkipXS/pi-subagents-lean/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "pack:check": "bun pm pack --dry-run",
    "package:smoke": "bun scripts/package-smoke.ts",
    "npm:production:smoke": "bun scripts/npm-production-smoke.ts",
    "release:validate": "bun scripts/release-validate.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=2 --exclude=test/pi-contract-smoke.test.ts",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  }
}
